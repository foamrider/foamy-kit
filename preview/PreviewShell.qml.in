import QtQuick
import Quickshell
import qs.Commons
import qs.Commons as Commons
import qs.Ui
import "harness"

// Generated by foamy-kit preview/render.py. Renders <plugin>/preview/Preview.qml
// state by state: (a) the simulated screen with the bar strip and the popup
// placed by FoamyPopup's real geometry, (b) the popup card alone.
ShellRoot {
  id: shell
  readonly property string out: Quickshell.env("FOAMY_OUT")
  readonly property string host: Quickshell.env("FOAMY_HOST")
  // 4.5 bars are full-screen windows; 4.0 bars are the strip itself.
  readonly property bool fullScreen: host === "4.5"
  readonly property string position: Quickshell.env("FOAMY_POSITION") || "top"
  readonly property int rounding: Number(Quickshell.env("FOAMY_ROUNDING") || 6)
  readonly property var onlyStates: (Quickshell.env("FOAMY_STATES") || "").split(",").filter(function(s) { return s !== "" })
  readonly property int thickness: 34
  property var preview: null
  property var states: []
  property int index: 0

  FloatingWindow {
    id: screenWindow
    implicitWidth: 1920
    implicitHeight: 1080
    color: "black"
    ScreenSim {
      id: sim
      position: shell.position
      thickness: shell.thickness
      fullScreenBar: shell.fullScreen
      stripColor: Commons.Color.bar.background
      iconColor: Commons.Color.bar.text
    }
    // Holds the Preview item; its FoamyPopup draws into sim's overlay.
    Item { id: previewHost }
  }

  FloatingWindow {
    id: stripWindow
    visible: !shell.fullScreen
    implicitWidth: sim.vertical ? shell.thickness : 1920
    implicitHeight: sim.vertical ? 1080 : shell.thickness
    color: "black"
    Item {
      id: stripAnchor
      width: sim.anchor.width
      height: sim.anchor.height
      x: sim.vertical ? (shell.thickness - width) / 2 : sim.anchor.x
      y: sim.vertical ? sim.anchor.y : (shell.thickness - height) / 2
    }
  }

  MockBar { id: bar; position: shell.position; barSize: shell.thickness }

  Component.onCompleted: {
    Style.cornerRadius = rounding
    var component = Qt.createComponent(Qt.resolvedUrl("@PREVIEW@"))
    if (component.status !== Component.Ready) {
      console.log("FOAMY FAIL preview did not load: " + component.errorString())
      Qt.quit()
      return
    }
    preview = component.createObject(previewHost, { bar: bar, anchorItem: fullScreen ? sim.anchor : stripAnchor })
    if (!preview || !preview.popup) {
      console.log("FOAMY FAIL Preview.qml must declare `readonly property Item popup`")
      Qt.quit()
      return
    }
    var all = preview.previewStates || ["default"]
    states = onlyStates.length ? all.filter(function(s) { return onlyStates.indexOf(s) !== -1 }) : all
    next.start()
  }

  Timer {
    id: next
    interval: 50
    onTriggered: {
      if (shell.index >= shell.states.length) {
        console.log("FOAMY DONE")
        Qt.quit()
        return
      }
      shell.preview.previewState = shell.states[shell.index]
      settle.interval = shell.preview.settleMs || 600
      settle.start()
    }
  }

  Timer {
    id: settle
    onTriggered: {
      var name = shell.states[shell.index]
      var card = shell.preview.popup.cardItem
      sim.grabToImage(function(screen) {
        var screenPath = shell.out + "/" + name + "-screen.png"
        if (!screen.saveToFile(screenPath)) console.log("FOAMY FAIL SAVE FAILED " + screenPath)
        else console.log("FOAMY SHOT " + screenPath)
        if (!card) { console.log("FOAMY FAIL no popup card for " + name); shell.index++; next.start(); return }
        card.grabToImage(function(tight) {
          var cardPath = shell.out + "/" + name + ".png"
          if (!tight.saveToFile(cardPath)) console.log("FOAMY FAIL SAVE FAILED " + cardPath)
          else console.log("FOAMY SHOT " + cardPath + " " + Math.round(card.width) + "x" + Math.round(card.height)
            + " at " + Math.round(card.x) + "," + Math.round(card.y))
          shell.index++
          next.start()
        })
      })
    }
  }
}

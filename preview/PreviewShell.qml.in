import QtQuick
import Quickshell
import qs.Commons
import qs.Commons as Commons
import qs.Ui
import "harness"

// Generated by foamy-kit preview/render.py. Renders <plugin>/preview/Preview.qml
// state by state: (a) the simulated screen with the bar strip and the popup
// placed by FoamyPopup's real geometry, (b) the popup card alone.
//
// The preview is loaded over file:// from the real plugin directory, the way
// the shell loads plugins, so plugin subdirectories need no qmldir.
ShellRoot {
  id: shell
  readonly property string out: Quickshell.env("FOAMY_OUT")
  readonly property string host: Quickshell.env("FOAMY_HOST")
  // 4.5 bars are full-screen windows; 4.0 bars are the strip itself.
  readonly property bool fullScreen: host === "4.5"
  readonly property string position: Quickshell.env("FOAMY_POSITION") || "top"
  readonly property int rounding: Number(Quickshell.env("FOAMY_ROUNDING") || 6)
  readonly property var onlyStates: (Quickshell.env("FOAMY_STATES") || "").split(",").filter(function(s) { return s !== "" })
  readonly property int thickness: 34
  property var preview: null
  property var states: []
  property int index: 0

  FloatingWindow {
    id: screenWindow
    implicitWidth: 1920
    implicitHeight: 1080
    color: "black"
    ScreenSim {
      id: sim
      position: shell.position
      thickness: shell.thickness
      fullScreenBar: shell.fullScreen
      stripColor: Commons.Color.bar.background
      iconColor: Commons.Color.bar.text
    }
  }

  FloatingWindow {
    id: stripWindow
    visible: !shell.fullScreen
    implicitWidth: sim.vertical ? shell.thickness : 1920
    implicitHeight: sim.vertical ? 1080 : shell.thickness
    color: "black"
    Item {
      id: stripAnchor
      width: sim.anchor.width
      height: sim.anchor.height
      x: sim.vertical ? (shell.thickness - width) / 2 : sim.anchor.x
      y: sim.vertical ? sim.anchor.y : (shell.thickness - height) / 2
    }
  }

  // The bar window's top-left on the simulated screen (4.0 strips sit on their edge).
  readonly property point barOrigin: fullScreen ? Qt.point(0, 0)
    : position === "bottom" ? Qt.point(0, 1080 - thickness)
    : position === "right" ? Qt.point(1920 - thickness, 0) : Qt.point(0, 0)

  MockBar { id: bar; position: shell.position; barSize: shell.thickness }

  // A PopupCard is its own (offscreen) window; its card is copied here, at the
  // place its anchor rect puts it, so the screen shot shows it.
  Image {
    id: cardCopy
    parent: sim.content
    visible: false
    z: 60
  }

  Component.onCompleted: {
    Style.cornerRadius = rounding
    var component = Qt.createComponent(Quickshell.env("FOAMY_PLUGIN_URL") + "/@PREVIEW@")
    if (component.status !== Component.Ready) {
      console.log("FOAMY FAIL preview did not load: " + component.errorString())
      Qt.quit()
      return
    }
    // `bar` and `anchorItem` are offered to every preview; service-only
    // previews may leave them undeclared.
    preview = component.createObject(sim.content, { bar: bar, anchorItem: fullScreen ? sim.anchor : stripAnchor })
    if (!preview) {
      console.log("FOAMY FAIL preview did not instantiate")
      Qt.quit()
      return
    }
    var all = preview.previewStates || ["default"]
    states = onlyStates.length ? all.filter(function(s) { return onlyStates.indexOf(s) !== -1 }) : all
    next.start()
  }

  function card() {
    var popup = shell.preview.popup
    if (!popup) return null
    if (popup.cardItem) return popup.cardItem
    return findCard(popup, 0)
  }

  // Popups without a cardItem (pre-kit forks of KeyboardPanel, rendered for
  // "before" shots): the card is the first BorderSurface inside.
  function findCard(item, depth) {
    if (!item || depth > 4) return null
    var kids = item.children || []
    for (var i = 0; i < kids.length; i++)
      if (kids[i] && "borderSpec" in kids[i] && "contentTopInset" in kids[i]) return kids[i]
    for (var j = 0; j < kids.length; j++) {
      var found = findCard(kids[j], depth + 1)
      if (found) return found
    }
    return null
  }

  // A PopupWindow-based card (FoamyPopupCard): place a copy on the screen.
  function placeCardCopy(done) {
    var popup = shell.preview.popup
    var item = card()
    if (!popup || !item || !popup.anchor || !popup.anchor.rect || !popup.visible) { cardCopy.visible = false; done(); return }
    item.grabToImage(function(result) {
      cardCopy.source = result.url
      cardCopy.x = shell.barOrigin.x + popup.anchor.rect.x
      cardCopy.y = shell.barOrigin.y + popup.anchor.rect.y
      cardCopy.visible = true
      Qt.callLater(done)
    })
  }

  Timer {
    id: next
    interval: 50
    onTriggered: {
      if (shell.index >= shell.states.length) {
        console.log("FOAMY DONE")
        Qt.quit()
        return
      }
      shell.preview.previewState = shell.states[shell.index]
      settle.interval = shell.preview.settleMs || 600
      settle.start()
    }
  }

  Timer {
    id: settle
    onTriggered: shell.placeCardCopy(function() {
      var name = shell.states[shell.index]
      sim.grabToImage(function(screen) {
        var screenPath = shell.out + "/" + name + "-screen.png"
        if (!screen.saveToFile(screenPath)) console.log("FOAMY FAIL SAVE FAILED " + screenPath)
        else console.log("FOAMY SHOT " + screenPath)
        var item = shell.card()
        if (!item) { shell.index++; next.start(); return }   // service previews may have no card
        item.grabToImage(function(tight) {
          var cardPath = shell.out + "/" + name + ".png"
          var at = cardCopy.visible ? Qt.point(cardCopy.x, cardCopy.y) : item.mapToItem(sim, 0, 0)
          if (!tight.saveToFile(cardPath)) console.log("FOAMY FAIL SAVE FAILED " + cardPath)
          else console.log("FOAMY SHOT " + cardPath + " " + Math.round(item.width) + "x" + Math.round(item.height)
            + " at " + Math.round(at.x) + "," + Math.round(at.y)
            + (shell.preview.popup && shell.preview.popup.availableCardHeight !== undefined
               ? " avail " + Math.round(shell.preview.popup.availableCardHeight) : ""))
          cardCopy.visible = false
          shell.index++
          next.start()
        })
      })
    })
  }
}
